cat << 'EOF' > .gitignore
# Terraform local state and runtime files
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
dist/
*.egg-info/
.pytest_cache/

# Sensitive keys and environment files
.env
.env.*
!.env.example
*.pem
*.key
*.cer

# IDE specific settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
EOF